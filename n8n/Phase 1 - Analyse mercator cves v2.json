        "jsCode": "// 1. Récupérer tous les items qui arrivent dans le nœud\nconst items = $input.all();\n\n// 2. Extraire uniquement la partie 'json' (tes données) pour faire un beau tableau\nconst data_brute = items.map(item => item.json);\n\n// 3. Retourner l'objet encapsulé avec le nom de ton choix\nreturn {\n  reference: data_brute\n};"
